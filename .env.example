# Development-only role-gate tokens. Use long random values locally and never
# use this prototype token mechanism for real clinical deployments.
ADMIN_API_TOKEN=replace-with-at-least-32-random-characters
DOCTOR_API_TOKEN=replace-with-at-least-32-random-characters

# Required before the doctor recommendation API can produce an HMAC signature.
ORDER_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Canonical deployed origin used by metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase backend. Use the publishable key in browser code only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Server-only. Never expose this with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

